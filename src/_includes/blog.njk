{% include '_header.njk'%}
{% include '_contact-bar.njk'%}

{% include '_navigation.njk'%}

<div class="container">

  
       <section>
        
            <h1 class="heading-1 margin-block-start-8">{{ h1 }}</h1>
               <div class="breadcrumb margin-block-end-8">
                {% set breadcrumb = collections.all | eleventyNavigationBreadcrumb("Blog", { includeSelf: true }) %}
                {{ breadcrumb | eleventyNavigationToHtml | safe }}
            </div>
            {% for post in collections.blog %}
            <div class="max-image even-columns margin-block-end-10">
                <a href="{{ post.url }}"><img class="featured-image" src="{{ post.data.image | url }}" alt="{{ post.data.alt}}"></a>
                
                <div class=" grid-auto-fit vertically-centered ">
                    <div class="flow">
                    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                    {# <p> <time datetime="{{ post.date }}">{{ post.date | postDate  }}</time></p> #}
                    </p>{{ post.data.description}}</p>
                    <a href="{{post.url}}">Read Article</a>
                    </div>
                </div>
          
            </div>
            {% endfor %}
         
          

        </section>

</div>

{% include '_cta-button-section.njk' %}


{% include '_footer.njk'%}