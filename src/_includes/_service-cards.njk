<div class="section">

    <h2 class="heading-2 text-center margin-block-end-8">Our Services</h2>
    <div class="container">

        
    
    <div class="grid-auto-fit">
        {% for post in collections.services | reverse %}
        <div class="service-card">
                {# <i class="{{post.data.icon}} fa-3x"></i></a> #}
                <a href="{{post.url}}"><img class="service-card__image" src="{{post.data.image}}" alt="{{post.data.alt}}"></a>
            <div class="flow">
                <a class="decoration-none" href="{{post.url}}"><h3>{{post.data.h1}}</h3></a>
                <p>{{post.data.description}}</p>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="mx-auto text-center margin-block-start-8">
         <a class="button text-center" data-type="primary" href="/services/">View Services</a>
    </div>

    </div>


</div>