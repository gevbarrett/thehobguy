<section class=" section bg-neutral-000">

    <div class="container">
        <div class="even-columns">

            <div class="map-text">
                <div class="flow">
                <h2>{{map.header}}</h2>
                <p>{{map.text}}</p>
                <div class="contact-item"><p><i class="fas fa-map-marker fa-1x"> </i> {{settings.address1}}<br>{{settings.address2}}<br>{{settings.address3}}</p></div> 
                <div class="contact-item"><i class="fas fa-phone fa-1x padding-inline-end-4"> </i><a href="tel:{{settings.phone}}"><span class="sr-only">Tel </span>{{settings.phone_display}}</a></div>
                </div>

            </div>

            <div class="iframe-container">
                <iframe class="responsive-iframe" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d167.66690311295233!2d-7.671277456476875!3d52.36225537935149!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48432fc5f256b79f%3A0xabd445ae41c8f8d4!2sSmart%20Art%20Signs!5e0!3m2!1sen!2sie!4v1700483647634!5m2!1sen!2sie" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>

    </div>

</section>