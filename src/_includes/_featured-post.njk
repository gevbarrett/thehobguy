 <!-- FEATURED POSTS  -->

<section class="section">
    <div class="text-center">
        <h2 class="margin-block-end-8">Latest News and Events</h2>
    </div>
        <div class="container">
            <div class="even-columns">
                
                {% for post in collections.blog | reverse %}
                {% if loop.index0 < 3%}
                
                <div class="featured-post  main-content-limit flow">
                    <img src="{{post.data.image}}" alt="{{post.data.alt}}">
                    <div class="flow">
                       <a class="decoration-none" href="{{post.url}}"> <h4 class="heading-3">{{post.data.title}}</h4></a>
                        <p>{{post.data.description}}</p>
                    </div>
                </div>


                {% endif %}
                {% endfor %}
                
            </div>

            <div class="text-center margin-block-start-8"> 
                <a class="button" data-type="primary" href="/blog/">View Latest News</a>
            </div>
        </div>   
</section>